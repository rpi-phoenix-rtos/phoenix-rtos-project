:{}:
# rpi4b standard init script, run by `psh -i /etc/rc.psh` from the ext2 root.
# `W` = wait for the command to exit (init/daemonize), `X` = start in the
# background, `T` = open a controlling terminal.
#
# DELIBERATELY MINIMAL, and not for the reason the old note here gave. Every
# driver and server — usb (keyboard), lwip (net), vcmbox, fb, audio, gpio, hwrng,
# thermal, sysinfo — is started by PLO from the syspage list in user.plo.yaml,
# before this script runs. Verified against the shipped SD image 2026-09-15 by
# reading the `app ram0 -x ...` lines out of its own loader.disk.
#
# So this script only adds the userspace layer on top, and the overlap with plo's
# list (bind/dummyfs-tmp/posixsrv) is idempotent. The old note claimed usb and
# lwip were still to be "added back in the next iteration", which was true during
# the #120/#118 staged bring-up and has been false ever since — it reads as though
# an SD boot has no keyboard, which it does.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
# Bind devfs onto /dev (bind retries the lookup; tolerates devfs coming up late).
W /bin/bind devfs /dev
# tmpfs at /tmp for pipes/sockets/scratch.
W /sbin/dummyfs -m /tmp -D
# POSIX server (pts, pipes, event queues) — psh interactive input needs it (#117).
X /bin/posixsrv
# Controlling terminal on the console, then the interactive shell.
T /dev/console
X /bin/psh
